{
  "name": "shodasha",
  "version": "0.1.0",
  "private": true,
  "description": "Personal time-management desktop app with activity tracking, habits, and kanban tasks",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:tauri": "cargo build --manifest-path src-tauri/Cargo.toml",
    "build:tracker": "cargo build --manifest-path tracker/Cargo.toml",
    "build:all": "npm run build && npm run build:tauri && npm run build:tracker",
    "tauri:dev": "tauri dev",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@tauri-apps/api": "^2.11.1",
    "lucide-react": "^1.26.0",
    "motion": "^12.42.2",
    "next": "^16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "agentation": "^3.0.2",
    "postcss": "^8.5.22",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2"
  }
}
